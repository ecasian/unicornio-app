{
  "name": "unicornio-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "test": "vitest run",
    "prisma:validate": "dotenv -e ../.env -- prisma validate",
    "verify:catalogo-db": "dotenv -e ../.env -- node scripts/verify-catalogo-db.mjs",
    "verify:stock-db": "dotenv -e ../.env -- prisma generate && npm run build && dotenv -e ../.env -- node scripts/verify-stock-db.mjs",
    "seed:staging": "node scripts/seed-staging.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.4",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/swagger": "^12.0.1",
    "@prisma/client": "6.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "prisma": "6.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.3",
    "@nestjs/schematics": "^12.0.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
