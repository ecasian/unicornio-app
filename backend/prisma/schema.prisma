generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id               Int      @id @default(autoincrement())
  nombre           String
  celular          String
  direccion        String
  manejaMedioLitro Boolean
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  stockObjetivos   StockObjetivo[]
  visitasCliente VisitaCliente[]
  registrosExistencias RegistroExistencias[]
  movimientosBitacora MovimientoBitacora[]
  pedidosProduccion PedidoProduccion[]
}

model Repartidor {
  id        Int      @id @default(autoincrement())
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visitasCliente VisitaCliente[]
  registrosExistencias RegistroExistencias[]
  movimientosBitacora MovimientoBitacora[]
  pedidosProduccion PedidoProduccion[]
}

model Sabor {
  id            Int                 @id @default(autoincrement())
  nombre        String
  activo        Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  presentaciones SaborPresentacion[]
  stockObjetivos StockObjetivo[]
  detallesExistencias DetalleExistencias[]
  detallesPedido DetallePedido[]
  detallesNecesidadSucursal DetalleNecesidadSucursal[]
  acondicionamientos AcondicionamientoYogurtBase[]
  inventariosSucursal DetalleInventarioSucursal[]
  objetivosSucursal StockObjetivoSucursal[]
  detallesPropuestaAbastecimiento DetallePropuestaAbastecimiento[]
}

model LoteYogurtBase {
  id Int @id @default(autoincrement())
  fechaElaboracion DateTime @db.Date
  cubetas10L Int
  cubetas6L Int
  cubetas4L Int
  litrosReales Decimal @db.Decimal(14, 3)
  createdAt DateTime @default(now())
  acondicionamientos AcondicionamientoYogurtBase[] @relation("YogurtBaseOrigen")
  @@index([fechaElaboracion])
}

model AcondicionamientoYogurtBase {
  id Int @id @default(autoincrement())
  loteId Int
  saborId Int
  claveSolicitud String @unique @db.Uuid
  litrosConsumidos Decimal @db.Decimal(14, 3)
  litrosObtenidos Decimal @db.Decimal(14, 3)
  createdAt DateTime @default(now())
  lote LoteYogurtBase @relation("YogurtBaseOrigen", fields: [loteId], references: [id], onDelete: Restrict)
  sabor Sabor @relation(fields: [saborId], references: [id], onDelete: Restrict)
  @@index([loteId, createdAt])
  @@index([saborId, createdAt])
}

enum EstadoConcentradoSucursal {
  BORRADOR
  CONFIRMADO
}

model Sucursal {
  id Int @id @default(autoincrement())
  nombre String @unique
  activo Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  necesidades NecesidadSucursal[]
  reportesInventario ReporteInventarioSucursal[]
  stockObjetivos StockObjetivoSucursal[]
  propuestasAbastecimiento PropuestaAbastecimiento[]
}

model StockObjetivoSucursal {
  sucursalId Int
  saborId Int
  litros Decimal @db.Decimal(14, 3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sucursal Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  sabor Sabor @relation(fields: [saborId], references: [id], onDelete: Restrict)

  @@id([sucursalId, saborId])
  @@index([saborId])
}

enum EstadoPropuestaAbastecimiento {
  BORRADOR
  CONFIRMADA
}

enum EstadoReferenciaAbastecimiento {
  DISPONIBLE
  SIN_DATOS
}

model PropuestaAbastecimiento {
  id Int @id @default(autoincrement())
  sucursalId Int
  fecha DateTime @db.Date
  version Int
  estado EstadoPropuestaAbastecimiento @default(BORRADOR)
  fuenteReporteId Int?
  fuenteFecha DateTime? @db.Date
  fuenteTurno TurnoInventarioSucursal?
  fuenteConfirmadoAt DateTime?
  creadaAt DateTime @default(now())
  confirmadaAt DateTime?
  sucursal Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  fuenteReporte ReporteInventarioSucursal? @relation(fields: [fuenteReporteId], references: [id], onDelete: Restrict)
  detalles DetallePropuestaAbastecimiento[]
  @@unique([sucursalId, fecha, version])
  @@index([sucursalId, fecha, estado, version])
}

model DetallePropuestaAbastecimiento {
  propuestaId Int
  saborId Int
  estadoReferencia EstadoReferenciaAbastecimiento
  objetivoLitros Decimal? @db.Decimal(14, 3)
  objetivoActualizadoAt DateTime?
  existenciaLitros Decimal? @db.Decimal(14, 3)
  sugerenciaLitros Decimal? @db.Decimal(14, 3)
  decisionLitros Decimal? @db.Decimal(14, 3)
  propuesta PropuestaAbastecimiento @relation(fields: [propuestaId], references: [id], onDelete: Restrict)
  sabor Sabor @relation(fields: [saborId], references: [id], onDelete: Restrict)
  @@id([propuestaId, saborId])
  @@index([saborId])
}

enum EstadoInventarioSucursal {
  BORRADOR
  CONFIRMADO
}

enum TurnoInventarioSucursal {
  MATUTINO
  VESPERTINO
}

model ReporteInventarioSucursal {
  id Int @id @default(autoincrement())
  sucursalId Int
  fecha DateTime @db.Date
  // Null is reserved for historical reports created before shift capture existed.
  turno TurnoInventarioSucursal?
  estado EstadoInventarioSucursal @default(BORRADOR)
  confirmadoAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sucursal Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  detalles DetalleInventarioSucursal[]
  propuestasAbastecimiento PropuestaAbastecimiento[]

  @@unique([sucursalId, fecha, turno])
  @@index([fecha, turno, estado])
  @@index([sucursalId, turno, fecha])
}

model DetalleInventarioSucursal {
  reporteId Int
  saborId Int
  litros Decimal @db.Decimal(14, 3)
  reporte ReporteInventarioSucursal @relation(fields: [reporteId], references: [id], onDelete: Restrict)
  sabor Sabor @relation(fields: [saborId], references: [id], onDelete: Restrict)

  @@id([reporteId, saborId])
  @@index([saborId])
}

model ConcentradoSucursales {
  id Int @id @default(autoincrement())
  fecha DateTime @db.Date @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  necesidades NecesidadSucursal[]
}

model NecesidadSucursal {
  id Int @id @default(autoincrement())
  concentradoId Int
  sucursalId Int
  estado EstadoConcentradoSucursal @default(BORRADOR)
  confirmadoAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  concentrado ConcentradoSucursales @relation(fields: [concentradoId], references: [id], onDelete: Restrict)
  sucursal Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  detalles DetalleNecesidadSucursal[]
  @@unique([concentradoId, sucursalId])
}

model DetalleNecesidadSucursal {
  necesidadSucursalId Int
  saborId Int
  capacidadLitros Int
  cantidad Int
  @@index([saborId, capacidadLitros])
  necesidad NecesidadSucursal @relation(fields: [necesidadSucursalId], references: [id], onDelete: Restrict)
  sabor Sabor @relation(fields: [saborId], references: [id], onDelete: Restrict)
  @@id([necesidadSucursalId, saborId, capacidadLitros])
}

model Presentacion {
  id                Int                 @id @default(autoincrement())
  nombre            String              @unique
  litrosEquivalentes Float
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  sabores           SaborPresentacion[]
  stockObjetivos    StockObjetivo[]
  detallesExistencias DetalleExistencias[]
  detallesPedido DetallePedido[]
}

model SaborPresentacion {
  saborId        Int
  presentacionId Int
  habilitada     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  sabor          Sabor        @relation(fields: [saborId], references: [id])
  presentacion   Presentacion @relation(fields: [presentacionId], references: [id])

  @@id([saborId, presentacionId])
}

model StockObjetivo {
  clienteId      Int
  saborId        Int
  presentacionId Int
  cantidad       Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  cliente        Cliente      @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  sabor          Sabor        @relation(fields: [saborId], references: [id], onDelete: Restrict)
  presentacion   Presentacion @relation(fields: [presentacionId], references: [id], onDelete: Restrict)

  @@id([clienteId, saborId, presentacionId])
}

enum TipoMovimiento {
  REGISTRO_EXISTENCIAS
  PEDIDO_PRODUCCION
}

enum EstadoPedidoProduccion {
  VIGENTE
  SUSTITUIDO
}

model VisitaCliente {
  id            Int                  @id @default(autoincrement())
  clienteId     Int
  repartidorId  Int
  llegadaAt     DateTime             @default(now())
  cliente       Cliente              @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  repartidor    Repartidor           @relation(fields: [repartidorId], references: [id], onDelete: Restrict)
  registrosExistencias RegistroExistencias[]

  @@unique([id, clienteId, repartidorId])
  @@index([clienteId, llegadaAt])
}

model RegistroExistencias {
  id          Int                  @id @default(autoincrement())
  clienteId   Int
  repartidorId Int
  visitaClienteId Int?
  corrigeRegistroExistenciasId Int? @unique
  createdAt   DateTime             @default(now())
  cliente     Cliente              @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  repartidor  Repartidor           @relation(fields: [repartidorId], references: [id], onDelete: Restrict)
  visitaCliente VisitaCliente?      @relation(fields: [visitaClienteId, clienteId, repartidorId], references: [id, clienteId, repartidorId], onDelete: Restrict)
  detalles    DetalleExistencias[]
  movimiento  MovimientoBitacora?
  pedidoProduccion PedidoProduccion?
  corrigeRegistroExistencias RegistroExistencias? @relation("CorreccionesExistencias", fields: [corrigeRegistroExistenciasId], references: [id], onDelete: Restrict)
  corregidoPor RegistroExistencias? @relation("CorreccionesExistencias")

  @@index([clienteId, createdAt])
}

model DetalleExistencias {
  registroExistenciasId Int
  saborId               Int
  presentacionId        Int
  cantidad              Int
  registroExistencias   RegistroExistencias @relation(fields: [registroExistenciasId], references: [id], onDelete: Restrict)
  sabor                 Sabor               @relation(fields: [saborId], references: [id], onDelete: Restrict)
  presentacion          Presentacion        @relation(fields: [presentacionId], references: [id], onDelete: Restrict)

  @@id([registroExistenciasId, saborId, presentacionId])
}

model PedidoProduccion {
  id                    Int @id @default(autoincrement())
  clienteId             Int
  repartidorId          Int
  registroExistenciasId Int @unique
  createdAt             DateTime @default(now())
  estado                EstadoPedidoProduccion @default(VIGENTE)
  cliente               Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  repartidor            Repartidor @relation(fields: [repartidorId], references: [id], onDelete: Restrict)
  registroExistencias   RegistroExistencias @relation(fields: [registroExistenciasId], references: [id], onDelete: Restrict)
  detalles              DetallePedido[]
  movimiento            MovimientoBitacora?
}

model DetallePedido {
  pedidoProduccionId Int
  saborId            Int
  presentacionId     Int
  cantidadSugerida   Int
  cantidadSolicitada Int
  pedidoProduccion   PedidoProduccion @relation(fields: [pedidoProduccionId], references: [id], onDelete: Restrict)
  sabor              Sabor @relation(fields: [saborId], references: [id], onDelete: Restrict)
  presentacion       Presentacion @relation(fields: [presentacionId], references: [id], onDelete: Restrict)

  @@id([pedidoProduccionId, saborId, presentacionId])
}

model MovimientoBitacora {
  id                    Int                  @id @default(autoincrement())
  clienteId             Int
  repartidorId          Int
  tipo                  TipoMovimiento
  registroExistenciasId Int?                 @unique
  pedidoProduccionId    Int?                 @unique
  createdAt             DateTime             @default(now())
  cliente               Cliente              @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  repartidor            Repartidor           @relation(fields: [repartidorId], references: [id], onDelete: Restrict)
  registroExistencias   RegistroExistencias? @relation(fields: [registroExistenciasId], references: [id], onDelete: Restrict)
  pedidoProduccion      PedidoProduccion? @relation(fields: [pedidoProduccionId], references: [id], onDelete: Restrict)
}
